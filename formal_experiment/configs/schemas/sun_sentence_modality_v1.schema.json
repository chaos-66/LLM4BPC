{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sun_sentence_modality_v1.schema.json",
  "title": "LLM-SE explicit sentence modality envelope v1",
  "description": "Interface version only. rule_record reuses the unchanged canonical contract and its runtime validator. Sentence and Rule Record validation diagnostics are reported separately; canonical span validation does not gate the independent sentence score.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rule_record", "sentence_modality"],
  "properties": {
    "schema_version": {"const": "sun_sentence_modality@1.0.0"},
    "rule_record": {"$ref": "stage2_prediction.schema.json"},
    "sentence_modality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "evidence", "uncertainty"],
      "properties": {
        "label": {"enum": ["definition", "obligation", "permission", "prohibition", null]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "uncertainty": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["incomplete_input", "mixed_independent_modalities", "corpus_boundary_ambiguous"]}
        }
      },
      "allOf": [{
        "if": {"properties": {"label": {"type": "null"}}},
        "then": {"properties": {"uncertainty": {"contains": {"const": "incomplete_input"}}}},
        "else": {"properties": {"evidence": {"minItems": 1}}}
      }]
    }
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "start", "end"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      },
      "description": "Exact source_text excerpt; Python character offsets, start inclusive and end exclusive. Runtime checks equality and bounds."
    }
  }
}
