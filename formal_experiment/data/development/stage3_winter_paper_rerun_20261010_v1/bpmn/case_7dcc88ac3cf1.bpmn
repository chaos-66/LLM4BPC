<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions" targetNamespace="urn:bpc:table3:r5:v1">
  <collaboration id="Collaboration">
    <participant id="Participant" name="Supervisory authority" processRef="Process" />
  </collaboration>
  <process id="Process" name="Supervisory authority" isExecutable="false">
    <laneSet id="LaneSet">
      <lane id="Lane_Actor" name="Supervisory authority">
        <flowNodeRef>Start</flowNodeRef>
        <flowNodeRef>Gateway_Applicability</flowNodeRef>
        <flowNodeRef>Activity_0</flowNodeRef>
        <flowNodeRef>Activity_2</flowNodeRef>
        <flowNodeRef>Activity_1</flowNodeRef>
        <flowNodeRef>End</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start" name="A multi-State draft code of conduct must be submitted to the Board before it is approved." />
    <exclusiveGateway id="Gateway_Applicability" name="Assess applicable condition" />
    <task id="Activity_0" name="Receive the multi-State draft code of conduct" />
    <task id="Activity_2" name="Approve the draft code, amendment or extension" />
    <task id="Activity_1" name="Submit the draft code to the Board before approving it" />
    <endEvent id="End" />
    <sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Gateway_Applicability" />
    <sequenceFlow id="Flow_1" sourceRef="Gateway_Applicability" targetRef="Activity_0">
      <conditionExpression>applicability_condition == true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_2" sourceRef="Activity_0" targetRef="Activity_2" />
    <sequenceFlow id="Flow_3" sourceRef="Activity_2" targetRef="Activity_1" />
    <sequenceFlow id="Flow_4" sourceRef="Activity_1" targetRef="End" />
  </process>
</definitions>
